<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- La veta se dibuja en una tesela pequeña, compartida por el menú y las ventanas de estudio. -->
  <DrawingBrush x:Key="Wood" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="Absolute" Viewport="0,0,32,8" Viewbox="0,0,32,8">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#A87048" Geometry="M0,0 H32 V8 H0Z"/>
        <GeometryDrawing Brush="#C8915D" Geometry="M0,0 H32 V1 H0Z M3,4 H17 V5 H3Z M22,3 H29 V4 H22Z"/>
        <GeometryDrawing Brush="#845337" Geometry="M0,6 H12 V7 H0Z M17,6 H32 V7 H17Z M13,2 H21 V3 H13Z"/>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <Style x:Key="Frame" TargetType="Border">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="BorderBrush" Value="#44302B"/><Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Background" Value="{StaticResource Wood}"/><Setter Property="Padding" Value="5"/>
  </Style>
  <Style x:Key="Paper" TargetType="Border">
    <Setter Property="BorderBrush" Value="#794F38"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="#FFF2D9"/><Setter Property="Padding" Value="5"/>
  </Style>
  <Style TargetType="{x:Type Button}">
    <Setter Property="MinWidth" Value="246"/>
    <Setter Property="MinHeight" Value="25"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type Button}">
        <Border x:Name="Row" Padding="8,3" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
            <Border x:Name="KeyCap" Grid.Column="1" Padding="4,0" Margin="12,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#D6BC90" Background="#FAE7C4">
              <TextBlock FontSize="11" Foreground="#705039" Text="{TemplateBinding Tag}"/>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDD3A4"/><Setter TargetName="Row" Property="BorderBrush" Value="#97613C"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="#E8C698"/><Setter TargetName="Row" Property="BorderBrush" Value="#794F38"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.48"/></Trigger>
          <Trigger Property="Tag" Value=""><Setter TargetName="KeyCap" Property="Visibility" Value="Collapsed"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type Separator}">
    <Setter Property="Margin" Value="7,3"/><Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type Separator}"><Border Height="1" Background="#D9BF96"/></ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
